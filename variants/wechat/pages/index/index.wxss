  pointer-events: none;
}
.ritual-count { display: flex; align-items: baseline; gap: 12rpx; }
.ritual-count__current {
  color: #f3ce68;
  font-size: 68rpx;
  line-height: 1;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 26rpx rgba(255,209,102,0.12);
}
