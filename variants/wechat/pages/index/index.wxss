/* ---------- v0.3.2：模式提示、静态方格图层与反馈 ---------- */
.mode-strip { min-height: 88rpx; padding: 18rpx 22rpx; display: flex; align-items: center; justify-content: space-between; }
.mode-strip__copy { min-width: 0; flex: 1; }
.mode-strip__title { color: #e6dfcf; font-size: 23rpx; font-weight: 600; }
.mode-strip__desc { margin-top: 5rpx; color: #777b85; font-size: 19rpx; line-height: 1.45; }
.mode-strip__action { margin-left: 18rpx; flex: none; color: #c8aa50; font-size: 21rpx; }

/* Canvas 只负责离屏式绘制/导出；用户真正看到的是普通 image。
   这样页面高速滚动时，方格与卡片由同一普通视图层滚动，避免 Canvas 延迟归位/拖影。 */
.canvas-shell { isolation: isolate; }
.life-canvas { position: absolute; inset: 0; opacity: 0; pointer-events: none; }
.life-grid-image { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.grid-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #626671; font-size: 20rpx; }

.amount-input { line-height: 94rpx; }
.form-control--note { line-height: 75rpx; }
.result__head { display: flex; align-items: center; justify-content: space-between; }
.result__delta { margin-left: 16rpx; padding: 5rpx 10rpx; flex: none; border-radius: 10rpx; background: rgba(255,255,255,0.05); color: #92959e; font-size: 18rpx; font-variant-numeric: tabular-nums; }
.result--light_up .result__delta { background: rgba(241,199,91,0.12); color: #e7c35f; }
.result--extinguish .result__delta { background: rgba(218,132,101,0.12); color: #d79d87; }
.result--calibration .result__delta { background: rgba(121,166,195,0.12); color: #9ec4dc; }

.theme-paper .mode-strip__title { color: #40372e; }
.theme-paper .mode-strip__desc { color: #776d61; }
.theme-paper .mode-strip__action { color: #97691f; }
.theme-paper .grid-loading { color: #8a8074; }
.theme-paper .result__delta { background: rgba(70,54,35,0.07); color: #75695c; }
.theme-paper .result--light_up .result__delta { background: #eadfbf; color: #8b651e; }
.theme-paper .result--extinguish .result__delta { background: #ead5cc; color: #9c5f4d; }
.theme-paper .result--calibration .result__delta { background: #d9e1e3; color: #56717f; }

/* ======================================================================
   v0.4.2 · 核心仪式舞台
   平时页面只显示普通 image；两个 Canvas 都不参与页面滚动：
   - snapshot-canvas 固定在屏幕外生成静态图
   - ritual-canvas 只在交易产生整数格变化时，以 fixed overlay 实时渲染
   ====================================================================== */
.snapshot-canvas {
  position: fixed;
  left: -12000px;
  top: 0;
  width: 8px;
  height: 8px;
  opacity: 0;
  pointer-events: none;
}

.ritual-overlay {
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  overflow: hidden;
  color: #f4efe5;
  background: #06070b;
}
.ritual-backdrop {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 42%, rgba(255,209,102,0.08), rgba(6,7,11,0.96) 58%, #05060a 100%);
}
.ritual-overlay--extinguish .ritual-backdrop {
  background: radial-gradient(circle at 50% 42%, rgba(151,91,70,0.075), rgba(6,7,11,0.97) 60%, #05060a 100%);
}
.ritual-shell {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
/* v0.4.2：动画时不再把人生方格关进“卡片”。整个视口就是主舞台。 */
.ritual-stage {
  position: absolute;
  z-index: 1;
  inset: 0;
  overflow: hidden;
  background: #06070b;
}
.ritual-canvas { width: 100%; height: 100%; display: block; }
.ritual-top-veil,
.ritual-bottom-veil {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  pointer-events: none;
}
.ritual-top-veil {
  top: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(5,6,10,0.96) 0%, rgba(5,6,10,0.62) 48%, rgba(5,6,10,0) 100%);
}
.ritual-bottom-veil {
  bottom: 0;
  height: 300rpx;
  background: linear-gradient(0deg, rgba(5,6,10,0.98) 0%, rgba(5,6,10,0.68) 47%, rgba(5,6,10,0) 100%);
}
.ritual-head {
  position: absolute;
  z-index: 3;
  top: calc(34rpx + env(safe-area-inset-top));
  left: 30rpx;
  right: 28rpx;
