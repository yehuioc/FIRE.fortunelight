  50% { opacity: 1; transform: scale(1.16); }
}
.theme-paper .today-marker__halo {
  background: radial-gradient(circle, rgba(255,243,210,0.52) 0%, rgba(168,116,31,0.20) 36%, rgba(168,116,31,0.00) 74%);
