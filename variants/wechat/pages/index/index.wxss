/* ---------- 首次引导：与首页互斥渲染 ---------- */
.onboarding {
  height: 100vh;
  padding: 34rpx 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #090b10;
  color: #f4f1e8;
  overflow: hidden;
}
.onboarding__head { flex: none; padding-top: 8rpx; }
.onboarding__eyebrow, .topbar__eyebrow { color: #7b745f; font-size: 19rpx; letter-spacing: 4rpx; }
.onboarding__brand { margin-top: 8rpx; color: #d8d2c5; font-size: 25rpx; font-weight: 600; }
.onboarding__body { height: 0; flex: 1; min-height: 0; width: 100%; box-sizing: border-box; }
.guide-panel { width: 100%; box-sizing: border-box; padding: 34rpx 0; }
.guide-panel--centered { min-height: 100%; display: flex; flex-direction: column; justify-content: center; }
.guide-panel--setup { padding-top: 34rpx; padding-bottom: 36rpx; }
.guide-panel__no { color: #b18e39; font-size: 21rpx; letter-spacing: 2rpx; }
.guide-panel__title { margin-top: 24rpx; color: #f2eee5; font-size: 46rpx; line-height: 1.38; font-weight: 700; letter-spacing: -1rpx; }
.guide-panel__title--setup { font-size: 39rpx; }
.guide-panel__title-gold { color: #f1c75b; }
.guide-panel__formula { margin-top: 42rpx; padding: 28rpx 12rpx; display: flex; align-items: center; justify-content: center; background: #0d1016; border: 1rpx solid rgba(241,199,91,0.12); border-radius: 22rpx; color: #ddd5c4; font-size: 23rpx; }
.formula-arrow { margin: 0 14rpx; color: #806a36; }
.guide-panel__copy { margin-top: 34rpx; color: #979aa4; font-size: 25rpx; line-height: 1.78; }
.guide-panel__quote { margin-top: 28rpx; color: #8c805e; font-size: 22rpx; line-height: 1.65; text-align: center; }
.principle-row { padding: 25rpx 0; display: flex; border-bottom: 1rpx solid rgba(255,255,255,0.07); }
.principle-row--first { margin-top: 28rpx; }
.principle-row__index { width: 58rpx; flex: none; color: #5f5130; font-size: 21rpx; }
.principle-row__title { color: #e8e3d8; font-size: 27rpx; font-weight: 600; }
.principle-row__desc { margin-top: 6rpx; color: #80838d; font-size: 22rpx; line-height: 1.55; }
.feedback-demo { margin-top: 24rpx; padding: 24rpx; border-radius: 20rpx; color: #a6a8ae; font-size: 21rpx; line-height: 1.55; }
.feedback-demo--up { margin-top: 34rpx; background: #211d12; border: 1rpx solid rgba(241,199,91,0.12); }
.feedback-demo--down { background: #211817; border: 1rpx solid rgba(207,137,111,0.12); }
.feedback-demo__big { margin-bottom: 7rpx; color: #f1c75b; font-size: 31rpx; font-weight: 700; }
.feedback-demo--down .feedback-demo__big { color: #d89d87; }

.mode-cards { margin-top: 28rpx; display: flex; justify-content: space-between; }
.mode-card { width: 48.5%; padding: 20rpx; box-sizing: border-box; background: #13161d; border: 2rpx solid transparent; border-radius: 18rpx; }
.mode-card--active { background: #1d1a12; border-color: rgba(241,199,91,0.62); }
.mode-card__top { display: flex; align-items: center; justify-content: space-between; }
.mode-card__title { color: #e7e2d8; font-size: 25rpx; font-weight: 700; }
.mode-card__tag { padding: 4rpx 9rpx; background: #3a311b; color: #e6c567; border-radius: 10rpx; font-size: 17rpx; }
.mode-card__desc { margin-top: 9rpx; color: #7f828c; font-size: 19rpx; line-height: 1.55; }
.mode-card--active .mode-card__desc { color: #a8a18e; }

.setup-group { margin-top: 28rpx; padding-top: 25rpx; border-top: 1rpx solid rgba(255,255,255,0.07); }
.setup-group__title { color: #c1a85d; font-size: 22rpx; font-weight: 600; }
.setup-field { margin-top: 20rpx; }
.setup-field__label { margin-bottom: 9rpx; color: #848791; font-size: 21rpx; }
.setup-control, .money-input { min-height: 82rpx; padding: 0 22rpx; box-sizing: border-box; display: flex; align-items: center; background: #161922; border: 1rpx solid rgba(255,255,255,0.08); border-radius: 17rpx; color: #eee9df; font-size: 27rpx; }
.setup-control--input { height: 82rpx; line-height: 82rpx; }
.setup-control--placeholder { color: #686c76; }
.setup-inline { display: flex; align-items: center; }
.setup-inline .setup-control { flex: 1; }
.setup-inline text { margin-left: 16rpx; color: #858892; font-size: 24rpx; }
.money-input text { margin-right: 12rpx; color: #777b85; font-size: 26rpx; }
.money-input input, .money-input__field { height: 82rpx; line-height: 82rpx; flex: 1; color: #eee9df; font-size: 27rpx; }
.quick-note, .advanced-hint { margin-top: 20rpx; padding: 18rpx 20rpx; background: #1d1a12; border-radius: 15rpx; color: #a89b76; font-size: 20rpx; line-height: 1.6; }
.advanced-hint { background: #14171e; color: #828690; }
.mini-segmented { padding: 5rpx; display: flex; background: #10131a; border-radius: 15rpx; }
.mini-segmented__item { width: 50%; padding: 15rpx 0; text-align: center; color: #747883; border-radius: 11rpx; font-size: 22rpx; }
.mini-segmented__item--active { background: #2a2516; color: #e8c565; }
.setup-switch-row { padding-top: 23rpx; display: flex; align-items: center; }
.setup-switch-copy { flex: 1; padding-right: 20rpx; }
.setup-switch-copy__title { color: #ded9cf; font-size: 23rpx; }
.setup-switch-copy__desc { margin-top: 5rpx; color: #777b85; font-size: 19rpx; line-height: 1.45; }
.model-note { margin-top: 20rpx; color: #676b75; font-size: 19rpx; line-height: 1.55; }

.onboarding__foot { flex: none; padding-top: 12rpx; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); background: #090b10; }
.guide-dots { height: 24rpx; display: flex; align-items: center; justify-content: center; }
.dot { width: 10rpx; height: 10rpx; margin: 0 5rpx; background: #373a43; border-radius: 10rpx; }
.dot--active { width: 30rpx; background: #c6a54c; }
.guide-actions { margin-top: 19rpx; display: flex; align-items: center; justify-content: space-between; }
.guide-actions__spacer { width: 190rpx; }
.secondary-btn, .primary-btn, .submit-btn { display: flex; align-items: center; justify-content: center; line-height: 1.2; }
.secondary-btn { width: 190rpx; height: 84rpx; margin: 0; padding: 0 20rpx; background: #151820; color: #999ca5; border-radius: 18rpx; font-size: 24rpx; }
.primary-btn { margin: 0; padding: 0 20rpx; background: #e6bd56; color: #14120d; font-weight: 700; border-radius: 18rpx; }
.primary-btn--compact { width: 270rpx; height: 84rpx; font-size: 24rpx; }

/* ---------- 主页面 ---------- */
.home { min-height: 100vh; padding: 26rpx 28rpx 80rpx; box-sizing: border-box; background: #07080c; color: #f4f1e8; }
.topbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 18rpx; align-items: center; }
.topbar__brand { min-width: 0; overflow: hidden; }
.topbar__title { margin-top: 5rpx; color: #e9e4da; font-size: 31rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: clip; }
.topbar__actions { display: flex; align-items: center; gap: 8rpx; flex: none; }
.text-icon { min-width: 68rpx; height: 54rpx; margin: 0; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; line-height: 1; background: #11141a; color: #9d9fa7; border-radius: 15rpx; font-size: 20rpx; }
.hero { padding: 52rpx 3rpx 27rpx; }
.hero__metric { display: flex; align-items: baseline; }
.hero__number { color: #f1c75b; font-size: 94rpx; line-height: 1; font-weight: 700; font-variant-numeric: tabular-nums; }
.hero__unit { margin-left: 13rpx; color: #c9c3b7; font-size: 27rpx; }
.hero__sub { margin-top: 14rpx; color: #82858f; font-size: 23rpx; }
.progress-track { height: 9rpx; margin-top: 27rpx; overflow: hidden; background: #1e222a; border-radius: 10rpx; }
.progress-fill { height: 100%; max-width: 100%; background: linear-gradient(90deg, #8b6d24, #f1c75b); border-radius: 10rpx; }
.progress-meta { margin-top: 13rpx; display: flex; justify-content: space-between; color: #747781; font-size: 20rpx; }
.card { margin-bottom: 20rpx; background: #11141a; border: 1rpx solid rgba(255,255,255,0.08); border-radius: 28rpx; box-sizing: border-box; }
.insight { padding: 22rpx 23rpx; display: flex; }
.insight__mark { width: 13rpx; height: 13rpx; margin: 9rpx 17rpx 0 0; flex: none; background: #f1c75b; border-radius: 50%; box-shadow: 0 0 18rpx rgba(241,199,91,0.42); }
.insight__content { flex: 1; }
.insight__label { color: #a48b4d; font-size: 19rpx; letter-spacing: 2rpx; }
.insight__text { margin-top: 7rpx; color: #d6d2c8; font-size: 24rpx; line-height: 1.65; }
.grid-card, .record-card, .recent { padding: 25rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-title { color: #f2eee5; font-size: 28rpx; font-weight: 600; }
.section-sub, .record-sub { margin-top: 6rpx; color: #7f828c; font-size: 20rpx; }
.legend { display: flex; align-items: center; }
.legend-item { margin-left: 13rpx; display: flex; align-items: center; color: #7d8089; font-size: 18rpx; }
.swatch { width: 11rpx; height: 11rpx; margin-right: 6rpx; background: #2a2e36; border-radius: 2rpx; }
.swatch--lit { background: #f1c75b; box-shadow: 0 0 8rpx rgba(241,199,91,0.45); }
.canvas-shell { position: relative; height: 470rpx; margin-top: 22rpx; overflow: hidden; background: #0b0e13; border-radius: 19rpx; }
.life-canvas { width: 100%; height: 470rpx; }
.grid-meta { margin-top: 16rpx; display: flex; justify-content: space-between; color: #70737c; font-size: 19rpx; }
.record-sub { margin-bottom: 21rpx; }
.segmented { padding: 5rpx; display: flex; background: #0b0e13; border-radius: 17rpx; }
.segmented__item { width: 50%; padding: 16rpx 0; box-sizing: border-box; text-align: center; color: #777a84; border-radius: 13rpx; font-size: 24rpx; }
.segmented__item--expense-active { background: #271d1a; color: #dca58f; }
.segmented__item--income-active { background: #292312; color: #f1c75b; }
.amount-line { margin-top: 25rpx; display: flex; align-items: center; border-bottom: 1rpx solid rgba(255,255,255,0.08); }
.amount-line__currency { color: #737680; font-size: 36rpx; }
.amount-input { height: 94rpx; margin-left: 12rpx; flex: 1; color: #f2eee5; font-size: 61rpx; font-weight: 600; }
.form-row { margin-top: 18rpx; display: flex; align-items: stretch; }
.date-picker { width: 42%; }
.form-control { height: 75rpx; min-height: 75rpx; padding: 0 18rpx; box-sizing: border-box; display: flex; align-items: center; background: #171a21; border-radius: 15rpx; color: #c8c7c1; font-size: 22rpx; }
.form-control--note { width: 56%; margin-left: 2%; }
.submit-btn { width: 100%; height: 86rpx; margin: 21rpx 0 0; padding: 0 24rpx; box-sizing: border-box; background: #e4bc56; color: #15130e; border-radius: 18rpx; font-size: 25rpx; font-weight: 700; text-align: center; }
.submit-btn--expense { background: #33231f; color: #ddb09e; }
.result { margin-top: 17rpx; padding: 19rpx; background: #171a21; border-radius: 16rpx; }
.result--light_up { background: #211d12; }
.result--extinguish { background: #211817; }
.result--calibration { background: #171d22; }
.result__title { color: #e2ddcf; font-size: 24rpx; font-weight: 600; }
.result__detail { margin-top: 6rpx; color: #858892; font-size: 20rpx; line-height: 1.55; }
.stats-row { display: flex; flex-wrap: wrap; justify-content: space-between; }
.stat { width: 48.6%; margin-bottom: 18rpx; padding: 21rpx; }
.stat__label { color: #797c86; font-size: 19rpx; }
.stat__value { margin-top: 10rpx; color: #e0dcd2; font-size: 27rpx; font-weight: 600; }
.stat__value--text { font-size: 24rpx; }
.stat__value.gold, .gold { color: #f1c75b; }
.recent { margin-top: 1rpx; }
.link { color: #c7a94f; font-size: 21rpx; }
.empty { padding: 32rpx 3rpx 25rpx; color: #777a84; font-size: 21rpx; line-height: 1.6; }
.empty__title { margin-bottom: 6rpx; color: #a0a2a8; font-size: 24rpx; }
.tx-row { padding: 18rpx 0; display: flex; align-items: center; border-top: 1rpx solid rgba(255,255,255,0.06); }
.tx-row__main { flex: 1; min-width: 0; }
.tx-row__note { color: #ddd9cf; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tx-row__date { margin-top: 5rpx; color: #6f727b; font-size: 18rpx; }
.tx-row__amount { margin-left: 16rpx; color: #c9c6bd; font-size: 24rpx; font-variant-numeric: tabular-nums; }
.privacy-note { padding: 16rpx 28rpx 0; color: #5e626b; font-size: 18rpx; line-height: 1.55; text-align: center; }

