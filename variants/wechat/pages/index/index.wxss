.ritual-progress-copy text:last-child { text-align: right; color: #666a74; }

/* 财富自由达成：只在真正从“未全亮”跨到“全部点亮”时触发。 */
.freedom-stage {
  position: absolute;
  z-index: 4;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: radial-gradient(circle at center, rgba(255,209,102,0.20), rgba(6,4,0,0.90) 62%, #05060a 100%);
  animation: freedom-veil-in 1.1s ease-out both;
}
@keyframes freedom-veil-in { from { opacity: 0; } to { opacity: 1; } }
.freedom-skip {
  position: absolute;
  z-index: 8;
  right: 28rpx;
  top: calc(34rpx + env(safe-area-inset-top));
  width: 104rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 18rpx;
  background: rgba(255,255,255,0.055);
  color: #8f929b;
  font-size: 20rpx;
  line-height: 1;
}
.freedom-ripple {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 560rpx;
  height: 560rpx;
  margin: -280rpx 0 0 -280rpx;
  border: 1rpx solid rgba(255,219,128,0.48);
  border-radius: 50%;
  opacity: 0;
  animation: freedom-ripple 5.5s ease-out forwards;
}
.freedom-ripple--1 { animation-delay: 0.20s; }
.freedom-ripple--2 { animation-delay: 0.70s; }
.freedom-ripple--3 { animation-delay: 1.20s; }
.freedom-ripple--4 { animation-delay: 1.85s; }
.freedom-ripple--5 { animation-delay: 2.60s; }
@keyframes freedom-ripple {
  0% { opacity: 0; transform: scale(0.018); }
  10% { opacity: 0.78; }
  100% { opacity: 0; transform: scale(3.35); }
}
.freedom-content {
  position: relative;
  z-index: 2;
  width: 88%;
  text-align: center;
  animation: freedom-rise 1.6s cubic-bezier(.2,.8,.2,1) 0.55s both;
}
@keyframes freedom-rise {
  from { opacity: 0; transform: translateY(32rpx) scale(0.93); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.freedom-eyebrow { color: #8f7a48; font-size: 18rpx; letter-spacing: 6rpx; }
.freedom-word {
  margin-top: 22rpx;
  color: #fff2c4;
  font-size: 172rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 9rpx;
  text-shadow: 0 0 34rpx rgba(255,209,102,0.25), 0 0 90rpx rgba(255,209,102,0.14);
  animation: freedom-glow 1.9s ease-in-out infinite alternate;
}
@keyframes freedom-glow {
  from { opacity: 0.84; text-shadow: 0 0 28rpx rgba(255,209,102,0.18); }
  to { opacity: 1; text-shadow: 0 0 44rpx rgba(255,232,167,0.35), 0 0 110rpx rgba(255,209,102,0.18); }
}
.freedom-zh { margin-top: 18rpx; color: #d8bb70; font-size: 31rpx; font-weight: 600; letter-spacing: 7rpx; }
.freedom-sub { margin: 24rpx auto 0; max-width: 500rpx; color: #777b84; font-size: 20rpx; line-height: 1.65; }

