/* ---------- v0.6.1 · 记录中心 / 习惯回路 ---------- */
.hero__number { display: inline-block; transform-origin: 50% 60%; }
.hero__number--flip { animation: freedom-number-flip .62s cubic-bezier(.18,.72,.2,1); }
@keyframes freedom-number-flip { 0% { transform: translateY(12rpx) scale(.97); opacity: .55; } 52% { transform: translateY(-5rpx) scale(1.025); opacity: 1; } 100% { transform: translateY(0) scale(1); opacity: 1; } }
.habit-card { padding: 25rpx; }
.habit-metrics { margin-top: 20rpx; display: flex; justify-content: space-between; gap: 8rpx; }
.habit-metric { min-width: 0; flex: 1; text-align: center; }
.habit-metric__value { color: #e8c864; font-size: 31rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.habit-metric__label { margin-top: 5rpx; color: #747883; font-size: 17rpx; line-height: 1.35; }
.activity-head { margin-top: 24rpx; display: flex; justify-content: space-between; gap: 20rpx; color: #777b84; font-size: 18rpx; }
.activity-grid { margin-top: 13rpx; display: flex; flex-direction: column; gap: 5rpx; }
.activity-row { display: flex; gap: 5rpx; }
.activity-cell { height: 13rpx; flex: 1; background: #20242c; border-radius: 3rpx; }
.activity-cell--1 { background: #5d5939; }.activity-cell--2 { background: #95803c; }.activity-cell--3 { background: #c6a84d; }.activity-cell--4 { background: #f0ca63; box-shadow: 0 0 9rpx rgba(241,199,91,.16); }
.activity-cell--today { outline: 1rpx solid rgba(255,238,182,.8); outline-offset: 1rpx; }.activity-cell--future { opacity: .18; }
.habit-bottom { margin-top: 22rpx; display: flex; flex-direction: column; gap: 12rpx; }
.achievement-preview { padding: 16rpx 18rpx; background: #0c0f14; border: 1rpx solid rgba(255,255,255,.06); border-radius: 18rpx; }
.achievement-preview__eyebrow { color: #696e78; font-size: 15rpx; letter-spacing: 2rpx; }.achievement-preview__name { margin-top: 5rpx; color: #d9d4ca; font-size: 21rpx; }
.weekly-tile { min-height: 84rpx; padding: 14rpx 16rpx; display: flex; align-items: center; gap: 14rpx; background: #0c0f14; border: 1rpx solid rgba(255,255,255,.06); border-radius: 18rpx; }
.weekly-tile__lamp { width: 16rpx; height: 16rpx; flex: none; border-radius: 50%; background: #343844; }
.weekly-tile--glow { border-color: rgba(241,199,91,.26); background: #121109; }.weekly-tile--glow .weekly-tile__lamp { background: #f1c75b; box-shadow: 0 0 18rpx rgba(241,199,91,.7); }
.weekly-tile__title { color: #ddd8ce; font-size: 21rpx; }.weekly-tile__sub { margin-top: 4rpx; color: #70747e; font-size: 17rpx; line-height: 1.4; }.weekly-tile__arrow { margin-left: auto; color: #8f7b42; font-size: 30rpx; }
.missed-card { padding: 20rpx 22rpx; display: flex; align-items: center; gap: 18rpx; }.missed-card__copy { flex: 1; min-width: 0; }.missed-card__title { color: #d9d4ca; font-size: 22rpx; font-weight: 600; }.missed-card__text { margin-top: 6rpx; color: #767a84; font-size: 18rpx; line-height: 1.5; }.missed-card__action { flex: none; color: #d1b55d; font-size: 20rpx; }
.quick-entry { margin: 20rpx 0 5rpx; }.quick-entry__label { margin-bottom: 9rpx; color: #797d86; font-size: 18rpx; }.choice-chip--quick { display: inline-flex; align-items: baseline; gap: 8rpx; }.choice-chip__meta { color: #5f646e; font-size: 15rpx; }.choice-chip--quick.choice-chip--active .choice-chip__meta { color: #a9904c; }
.result__exact { margin-top: 10rpx; color: #a9a49a; font-size: 20rpx; font-variant-numeric: tabular-nums; }
.theme-paper .habit-metric__value { color: #a8741f; }.theme-paper .habit-metric__label, .theme-paper .activity-head, .theme-paper .weekly-tile__sub, .theme-paper .missed-card__text, .theme-paper .quick-entry__label { color: #7d7265; }
.theme-paper .activity-cell { background: #ddd4c6; }.theme-paper .activity-cell--1 { background: #d6c49d; }.theme-paper .activity-cell--2 { background: #c9a967; }.theme-paper .activity-cell--3 { background: #b8842b; }.theme-paper .activity-cell--4 { background: #9d6b1c; box-shadow: none; }
.theme-paper .achievement-preview, .theme-paper .weekly-tile { background: #f1eadf; border-color: #ded3c3; }.theme-paper .achievement-preview__name, .theme-paper .weekly-tile__title, .theme-paper .missed-card__title { color: #40372e; }.theme-paper .weekly-tile--glow { background: #f0e2bd; border-color: #c9a65f; }.theme-paper .weekly-tile__lamp { background: #c9c0b2; }.theme-paper .weekly-tile--glow .weekly-tile__lamp { background: #a8741f; box-shadow: 0 0 12rpx rgba(168,116,31,.35); }.theme-paper .result__exact { color: #75695c; }
.achievement-unlock { margin-top: 13rpx; padding: 15rpx 17rpx; display: flex; align-items: center; gap: 12rpx; background: #11130e; border: 1rpx solid rgba(185,203,118,.18); border-radius: 16rpx; }
.achievement-unlock__mark { color: #a8c889; font-size: 23rpx; }.achievement-unlock__eyebrow { color: #747d66; font-size: 15rpx; letter-spacing: 1rpx; }.achievement-unlock__name { margin-top: 4rpx; color: #d9ddc8; font-size: 21rpx; }.achievement-unlock__arrow { margin-left: auto; color: #77875c; font-size: 28rpx; }
.theme-paper .achievement-unlock { background: #eef0df; border-color: #cbd0a8; }.theme-paper .achievement-unlock__mark { color: #788333; }.theme-paper .achievement-unlock__eyebrow { color: #7e805f; }.theme-paper .achievement-unlock__name { color: #45452f; }

/* ---------- v0.6.2 · 顶栏、周回顾入口与记账可用性 ---------- */
.topbar { display:flex; flex-direction:column; align-items:stretch; gap:18rpx; }
.topbar__brand { min-width:0; overflow:visible; padding:4rpx 4rpx 0; }
.topbar__eyebrow { font-size:18rpx; letter-spacing:3rpx; }
.topbar__title { margin-top:7rpx; font-size:34rpx; line-height:1.24; white-space:normal; overflow:visible; text-overflow:clip; }
.topbar__subtitle { margin-top:7rpx; color:#6f737d; font-size:19rpx; line-height:1.45; }
.topbar__actions { width:100%; display:grid; grid-template-columns:1fr 1fr 1fr; gap:10rpx; }
.text-icon { width:100%; min-width:0; height:66rpx; margin:0; padding:0 10rpx; border-radius:16rpx; font-size:21rpx; font-weight:600; }
.theme-paper .topbar__subtitle { color:#83776a; }

.weekly-dock { min-height:112rpx; margin-top:24rpx; padding:20rpx 21rpx; display:flex; align-items:center; gap:18rpx; }
.weekly-dock__copy { min-width:0; flex:1; }
.weekly-dock__eyebrow { color:#6f737d; font-size:15rpx; letter-spacing:2rpx; }
.weekly-dock__title { margin-top:5rpx; color:#ddd8ce; font-size:23rpx; font-weight:650; }
.weekly-dock__sub { margin-top:6rpx; color:#747883; font-size:18rpx; line-height:1.45; }
.weekly-dock__status { flex:none; min-width:92rpx; display:flex; flex-direction:column; align-items:center; gap:8rpx; color:#717680; font-size:16rpx; }
.weekly-dock__lamp { width:18rpx; height:18rpx; border-radius:50%; background:#343844; }
.weekly-dock--glow { background:#151309; border-color:rgba(241,199,91,.30); }
.weekly-dock--glow .weekly-dock__lamp { background:#f1c75b; box-shadow:0 0 20rpx rgba(241,199,91,.76); }
.weekly-dock--glow .weekly-dock__status { color:#c9aa55; }
.theme-paper .weekly-dock__eyebrow,.theme-paper .weekly-dock__sub,.theme-paper .weekly-dock__status { color:#83776a; }
.theme-paper .weekly-dock__title { color:#40372e; }
.theme-paper .weekly-dock__lamp { background:#c9c0b2; }
.theme-paper .weekly-dock--glow { background:#f0e2bd; border-color:#c9a65f; }
.theme-paper .weekly-dock--glow .weekly-dock__lamp { background:#a8741f; box-shadow:0 0 12rpx rgba(168,116,31,.4); }

.home-module { scroll-margin-top:24rpx; }
.record-head { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; }
.record-head > view:first-child { min-width:0; flex:1; }
.record-help { flex:none; padding-top:2rpx; color:#c7a94f; font-size:19rpx; line-height:1.4; }
.inline-tip { margin:18rpx 0 20rpx; padding:15rpx 17rpx; border-radius:14rpx; background:#141820; color:#7d818b; font-size:18rpx; line-height:1.55; }
.theme-paper .record-help { color:#98691f; }
.theme-paper .inline-tip { background:#eee6da; color:#786e62; }

.choice-chip { min-height:58rpx; box-sizing:border-box; display:inline-flex; align-items:center; justify-content:center; line-height:1.25; text-align:center; }
.choice-chip--small { min-height:54rpx; }
.choice-chip--quick { align-items:center; justify-content:center; gap:8rpx; }
.choice-chip__label,.choice-chip__meta { display:inline-flex; align-items:center; line-height:1.2; }
.choice-chip__meta { transform:translateY(0); }

@media (max-width: 420px) {
  .home { padding-left:22rpx; padding-right:22rpx; }
  .topbar { gap:16rpx; }
  .topbar__title { font-size:32rpx; }
  .topbar__subtitle { font-size:18rpx; }
  .text-icon { height:64rpx; font-size:20rpx; }
  .weekly-dock { padding:18rpx; }
  .weekly-dock__status { min-width:82rpx; }
  .record-head { gap:12rpx; }
  .legend { max-width:56%; flex-wrap:wrap; justify-content:flex-end; row-gap:6rpx; }
}

