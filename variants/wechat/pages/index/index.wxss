.ritual-overlay--extinguish .ritual-title { color: #d9b3a4; }
.ritual-skip {
  width: 104rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 18rpx;
  color: #8f929b;
  font-size: 20rpx;
  line-height: 1;
}
.ritual-foot {
  position: absolute;
  z-index: 3;
  left: 32rpx;
  right: 32rpx;
