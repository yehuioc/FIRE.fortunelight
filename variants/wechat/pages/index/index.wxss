/* v0.4.2 · 今天坐标保持为持续呼吸的普通 View。
   它与静态方格 image 同层滚动，不使用可见 Canvas，因此不会重新引入高速滚动拖影。 */
.today-marker {
  position: absolute;
  z-index: 3;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.today-marker__halo {
  position: absolute;
