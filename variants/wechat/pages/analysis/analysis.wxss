.section { padding: 25rpx; }.empty { padding: 30rpx 0 12rpx; color: #777b84; font-size: 21rpx; line-height: 1.6; }
.break-row { margin-top: 23rpx; }.break-row__head { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; color: #d7d2c8; font-size: 22rpx; }.break-row__amount { color: #a5a29a; font-variant-numeric: tabular-nums; }.bar { height: 10rpx; margin-top: 10rpx; overflow: hidden; background: #222630; border-radius: 999rpx; }.bar__fill { height: 100%; min-width: 3rpx; background: #caa744; border-radius: 999rpx; }
.nature-row { padding: 18rpx 0; display: grid; grid-template-columns: 1fr auto 100rpx; gap: 12rpx; border-top: 1rpx solid rgba(255,255,255,.06); color: #d6d2c9; font-size: 21rpx; }.nature-row:first-of-type { margin-top: 15rpx; }.nature-row__amount, .nature-row__share { color: #989a9f; text-align: right; font-variant-numeric: tabular-nums; }
.chip-scroll { width: 100%; margin-top: 17rpx; white-space: nowrap; }.chip-row { display: inline-flex; align-items: center; gap: 10rpx; min-width: 100%; }.chip-row--wrap { display: flex; min-width: 0; flex-wrap: wrap; margin-top: 10rpx; }.choice-chip { padding: 11rpx 17rpx; flex: none; background: #171a21; border: 1rpx solid rgba(255,255,255,.07); border-radius: 999rpx; color: #848892; font-size: 20rpx; }.choice-chip--small { padding: 9rpx 14rpx; font-size: 19rpx; }.choice-chip--active { background: #2c2617; border-color: rgba(241,199,91,.45); color: #e8c965; }.detail-block { margin-top: 18rpx; }.detail-label { color: #6d717b; font-size: 18rpx; }.trend-canvas { width: 100%; height: 360rpx; margin-top: 18rpx; background: #0b0e13; border-radius: 17rpx; }
.export-btn { width: 100%; height: 82rpx; margin: 22rpx 0 0; display: flex; align-items: center; justify-content: center; background: #e1b954; color: #17140e; border-radius: 17rpx; font-size: 24rpx; font-weight: 700; }.export-hint { margin-top: 13rpx; color: #8d9098; font-size: 19rpx; line-height: 1.55; }
