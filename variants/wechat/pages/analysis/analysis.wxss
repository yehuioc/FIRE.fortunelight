.analysis-page { min-height: 100vh; padding: 26rpx 28rpx 70rpx; box-sizing: border-box; background: #07080c; color: #eee9df; }
.card { margin-bottom: 20rpx; background: #11141a; border: 1rpx solid rgba(255,255,255,.08); border-radius: 26rpx; box-sizing: border-box; }
.period { padding: 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.period__copy { min-width: 0; flex: 1; }.period__title, .section-title { color: #f1ede3; font-size: 29rpx; font-weight: 650; }.period__sub, .section-copy { margin-top: 7rpx; color: #7b7f89; font-size: 19rpx; line-height: 1.55; }
.period-switch { padding: 4rpx; display: flex; flex: none; background: #0b0e13; border-radius: 14rpx; }.period-switch__item { padding: 12rpx 16rpx; color: #747883; border-radius: 11rpx; font-size: 20rpx; }.period-switch__item--active { background: #2b2516; color: #e7c55f; }
