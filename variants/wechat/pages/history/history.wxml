<page-meta page-style="background-color: {{pageBackground}};" />
<view class="container history-page {{themeClass}} {{appearanceClass}}">
  <view class="summary card">
    <view class="summary__title">{{count}} 笔记录</view>
    <view class="summary__sub">普通记录可以删除并立即重算；“起始自由本金”属于模型基准，请在设置中修改。</view>
  </view>

  <view wx:if="{{actionFeedback}}" class="action-feedback card">{{actionFeedback}}</view>
  <view wx:if="{{items.length === 0}}" class="empty card">还没有任何交易记录。</view>
  <block wx:for="{{items}}" wx:key="id">
    <view class="tx card">
      <view class="tx__bar {{item.type === 'income' ? 'tx__bar--income' : ''}}"></view>
      <view class="tx__main"><view class="tx__note">{{item.noteText}}</view><view class="tx__date">{{item.occurred_on}}<text wx:if="{{item.metaText}}"> · {{item.metaText}}</text></view></view>
      <view class="tx__amount {{item.type === 'income' ? 'gold' : ''}}">{{item.sign}}{{item.amountText}}</view>
      <view wx:if="{{item.locked}}" class="delete-btn"><text>基准</text></view>
      <button wx:else class="delete-btn" data-id="{{item.id}}" bindtap="remove"><text>删除</text></button>
    </view>
  </block>
  <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore"><text>继续加载（已显示 {{shown}} / {{count}}）</text></button>
</view>
