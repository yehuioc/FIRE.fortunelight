.preset-page { min-height: 100vh; padding: 28rpx 28rpx 70rpx; box-sizing: border-box; background: #07080c; color: #eee9df; }
.card { margin-bottom: 20rpx; padding: 26rpx; background: #11141a; border: 1rpx solid rgba(255,255,255,.08); border-radius: 26rpx; }
.intro__title, .section-title { color: #f1ede3; font-size: 29rpx; font-weight: 650; }
.intro__text, .empty, .foot-note { margin-top: 12rpx; color: #7d818b; font-size: 21rpx; line-height: 1.65; }
.field { margin-top: 22rpx; }
.field__label { margin-bottom: 9rpx; color: #8b8e96; font-size: 21rpx; }
.optional { color: #666a73; font-size: 18rpx; }
.control { min-height: 78rpx; padding: 0 20rpx; box-sizing: border-box; display: flex; align-items: center; background: #171a21; border-radius: 15rpx; color: #ddd8ce; font-size: 23rpx; }
.control--input { height: 78rpx; line-height: 78rpx; }
.save-btn { width: 100%; height: 82rpx; margin: 24rpx 0 0; display: flex; align-items: center; justify-content: center; background: #e1b954; color: #17140e; border-radius: 17rpx; font-size: 24rpx; font-weight: 700; }
.preset-row { padding: 20rpx 0; display: flex; align-items: center; border-top: 1rpx solid rgba(255,255,255,.06); }
.preset-row:first-of-type { margin-top: 12rpx; }
.preset-row__main { min-width: 0; flex: 1; }
.preset-row__title { color: #ded9cf; font-size: 23rpx; }
.preset-row__meta { margin-top: 6rpx; color: #737781; font-size: 19rpx; line-height: 1.5; }
.delete-btn { width: 100rpx; height: 58rpx; margin: 0 0 0 15rpx; padding: 0; display: flex; align-items: center; justify-content: center; background: #211817; color: #cc9681; border-radius: 13rpx; font-size: 19rpx; }
.foot-note { padding: 0 12rpx; text-align: center; }
.theme-paper.preset-page { background: #eee7db; color: #2d2720; }
.theme-paper .card { background: #faf6ee; border-color: #ddd2c2; }
.theme-paper .intro__title, .theme-paper .section-title, .theme-paper .preset-row__title { color: #332c24; }
.theme-paper .intro__text, .theme-paper .empty, .theme-paper .foot-note, .theme-paper .field__label, .theme-paper .preset-row__meta { color: #7d7265; }
.theme-paper .control { background: #eee6da; color: #51483e; }
.theme-paper .save-btn { background: #a8741f; color: #fffaf0; }
.theme-paper .preset-row { border-color: #e0d6c8; }
.theme-paper .delete-btn { background: #ead5cc; color: #955d4d; }

