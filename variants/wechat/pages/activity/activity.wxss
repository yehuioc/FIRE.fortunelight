.activity-page { min-height: 100vh; padding: 26rpx 28rpx 70rpx; box-sizing: border-box; background: #07080c; color: #eee9df; }
.card { margin-bottom: 20rpx; background: #11141a; border: 1rpx solid rgba(255,255,255,.08); border-radius: 26rpx; box-sizing: border-box; }
.hero { padding: 28rpx; }.hero__eyebrow,.why__eyebrow { color:#8f783d; font-size:16rpx; letter-spacing:3rpx; }.hero__title { margin-top:8rpx; color:#f0ece2; font-size:38rpx; font-weight:700; }.hero__copy { margin-top:9rpx; color:#7a7e87; font-size:20rpx; line-height:1.55; }
.metric-grid { display:flex; flex-wrap:wrap; justify-content:space-between; }.metric { width:48.6%; padding:22rpx; text-align:center; }.metric__value { color:#efcb67; font-size:38rpx; font-weight:700; font-variant-numeric:tabular-nums; }.metric__label { margin-top:5rpx; color:#737781; font-size:18rpx; }
.section { padding:25rpx; }.section-head { display:flex; align-items:flex-start; justify-content:space-between; gap:15rpx; }.section-title,.why__title { color:#eee9df; font-size:28rpx; font-weight:650; }.section-copy,.why__copy { margin-top:7rpx; color:#777b84; font-size:19rpx; line-height:1.55; }.section-badge { color:#9d874b; font-size:18rpx; flex:none; }
.activity-grid { margin-top:20rpx; display:flex; flex-direction:column; gap:6rpx; }.activity-row { display:flex; gap:6rpx; }.activity-cell { height:18rpx; flex:1; background:#20242c; border-radius:4rpx; }.activity-cell--1 { background:#5d5939; }.activity-cell--2 { background:#95803c; }.activity-cell--3 { background:#c6a84d; }.activity-cell--4 { background:#f0ca63; box-shadow:0 0 10rpx rgba(241,199,91,.18); }.activity-cell--today { outline:1rpx solid rgba(255,238,182,.8); outline-offset:1rpx; }.activity-cell--future { opacity:.18; }
.weekly { min-height:110rpx; padding:22rpx; display:flex; align-items:center; gap:16rpx; }.weekly__lamp { width:18rpx; height:18rpx; flex:none; border-radius:50%; background:#343844; }.weekly--glow { background:#121109; border-color:rgba(241,199,91,.3); }.weekly--glow .weekly__lamp { background:#f1c75b; box-shadow:0 0 20rpx rgba(241,199,91,.75); }.weekly__copy { flex:1; min-width:0; }.weekly__title { color:#ddd8ce; font-size:23rpx; }.weekly__sub { margin-top:5rpx; color:#737781; font-size:18rpx; line-height:1.45; }.weekly__arrow { color:#9b8448; font-size:32rpx; }
.achievement { padding:20rpx 0; display:flex; align-items:flex-start; gap:14rpx; border-top:1rpx solid rgba(255,255,255,.06); opacity:.55; }.achievement:first-of-type { margin-top:12rpx; }.achievement--unlocked { opacity:1; }.achievement__mark { width:28rpx; color:#5f646e; font-size:20rpx; }.achievement--unlocked .achievement__mark { color:#e7c55f; }.achievement--weird.achievement--unlocked .achievement__mark { color:#a8c889; }.achievement__copy { flex:1; min-width:0; }.achievement__name { color:#d8d3c9; font-size:21rpx; }.achievement__desc { margin-top:5rpx; color:#71757e; font-size:17rpx; line-height:1.45; }.achievement__bar { height:6rpx; margin-top:10rpx; overflow:hidden; background:#222630; border-radius:999rpx; }.achievement__fill { height:100%; background:#9f8740; border-radius:999rpx; }.achievement__progress { width:82rpx; flex:none; color:#767a83; font-size:17rpx; text-align:right; }
.why { padding:25rpx; }.why__title { margin-top:9rpx; }.why__action { margin-top:17rpx; color:#c5a84e; font-size:20rpx; }.empty { color:#777b84; font-size:20rpx; }
.theme-paper.activity-page { background:#eee7db; color:#2d2720; }.theme-paper .card { background:#faf6ee; border-color:#ddd2c2; }.theme-paper .hero__title,.theme-paper .section-title,.theme-paper .why__title,.theme-paper .achievement__name,.theme-paper .weekly__title { color:#40372e; }.theme-paper .hero__copy,.theme-paper .section-copy,.theme-paper .why__copy,.theme-paper .achievement__desc,.theme-paper .achievement__progress,.theme-paper .weekly__sub,.theme-paper .metric__label { color:#7d7265; }.theme-paper .metric__value { color:#a8741f; }.theme-paper .activity-cell { background:#ddd4c6; }.theme-paper .activity-cell--1 { background:#d6c49d; }.theme-paper .activity-cell--2 { background:#c9a967; }.theme-paper .activity-cell--3 { background:#b8842b; }.theme-paper .activity-cell--4 { background:#9d6b1c; box-shadow:none; }.theme-paper .weekly--glow { background:#f0e2bd; border-color:#c9a65f; }.theme-paper .achievement { border-color:#e0d6c8; }.theme-paper .achievement__bar { background:#e0d6c8; }.theme-paper .achievement__fill { background:#a8741f; }

