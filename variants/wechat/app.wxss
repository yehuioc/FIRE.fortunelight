page {
  min-height: 100%;
  background: #07080c;
  color: #f4f1e8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
button { box-sizing: border-box; }
button::after { border: none; }
.container { padding: 28rpx; box-sizing: border-box; }
.card {
  background: #11141a;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 28rpx;
  box-sizing: border-box;
}
.section-title { color: #f2eee5; font-size: 28rpx; font-weight: 600; }
.muted { color: #858994; }
.gold { color: #f1c75b; }

/* v0.6.2 · 全页统一字体族与基础字号比例。页面级语义字号在各自 WXSS 中继续等比派生。 */
.font-system, .font-system input, .font-system button {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.font-serif, .font-serif input, .font-serif button {
  font-family: "Songti SC", STSong, SimSun, serif;
}
.font-scale-85 .section-title { font-size:23.8rpx; }
.font-scale-90 .section-title { font-size:25.2rpx; }
.font-scale-95 .section-title { font-size:26.6rpx; }
.font-scale-105 .section-title { font-size:29.4rpx; }
.font-scale-110 .section-title { font-size:30.8rpx; }
.font-scale-115 .section-title { font-size:32.2rpx; }
